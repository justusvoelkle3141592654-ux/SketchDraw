{
  "name": "canvas-forge",
  "productName": "Canvas Forge",
  "version": "0.1.0",
  "description": "Raster-Zeichen- und Mal-App für Windows",
  "author": "Canvas Forge",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron .",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:dir": "npm run build && electron-builder --win dir --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "fflate": "0.8.3",
    "globals": "16.4.0",
    "lucide-react": "0.544.0",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "zustand": "5.0.8"
  },
  "build": {
    "appId": "app.canvasforge.desktop",
    "productName": "Canvas Forge",
    "copyright": "Copyright © 2026 Canvas Forge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "cforge",
        "name": "Canvas Forge Dokument",
        "description": "Canvas Forge Dokument",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Canvas Forge",
      "artifactName": "CanvasForge-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CanvasForge-Portable-${version}.${ext}"
    }
  }
}
